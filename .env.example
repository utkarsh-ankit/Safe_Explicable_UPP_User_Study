SECRET_KEY=replace_this_before_deployment
DATABASE_PATH=data/study.sqlite3
ADMIN_TOKEN=replace_this_admin_token
ALLOW_CONDITION_OVERRIDE=0

# Prolific
# Completion code from the Prolific study's "Completion codes" settings.
# Leave empty to show a locally generated code instead (useful for piloting).
PROLIFIC_COMPLETION_CODE=
PROLIFIC_RETURN_BASE=https://app.prolific.com/submissions/complete
# 1 = failing the attention check also voids the completion code.
# Keep this at 0 unless the study description says a failed check voids payment;
# failed participants are flagged as sanity_passed=0 and excluded at analysis.
REVOKE_CODE_ON_SANITY_FAIL=0
